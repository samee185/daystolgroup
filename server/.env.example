# Copy to server/.env for local development. Never commit .env.
# On Hostinger, set the same variables in the Node.js app's Environment variables panel.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /daystol
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/daystol?retryWrites=true&w=majority

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the website is served. Local: Vite dev server. Production: https://your-domain.com
PUBLIC_URL=http://localhost:5173

# Image uploads. Cloudinary dashboard > Settings > API Keys > "API environment variable".
# Looks like cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Email alerts for new enquiries and fault reports. Optional: forms still save without it.
# Option 1 (now): Resend. Username is the word "resend", password is your API key (re_...).
# Until you verify your domain in Resend, send from onboarding@resend.dev; Resend then only
# delivers to the email you signed up with, so customer confirmation emails will not arrive yet.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Daystol Group <onboarding@resend.dev>"

# Option 2 (after buying Hostinger): your business mailbox. Replace the five lines above with
# these (hPanel > Emails > your mailbox > "Connect apps & devices" shows the settings):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@your-domain.com
# SMTP_PASS=your-mailbox-password
# MAIL_FROM="Daystol Group <info@your-domain.com>"

# Paystack (online payments). Paystack dashboard > Settings > API Keys & Webhooks.
# Use the TEST secret key (sk_test_...) until the site is live. Without it, checkout is switched off.
PAYSTACK_SECRET_KEY=
